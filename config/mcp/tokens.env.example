# Tokens for the MCP servers declared in config/mcp/servers*.json (auth.type bearer_env).
# cp config/mcp/tokens.env.example config/mcp/tokens.env   (gitignored)
# Loaded by worker-agents and mcp-example only; the rest of .env never reaches the workers.
EXAMPLE_MCP_TOKEN=change-me-to-a-long-random-value
