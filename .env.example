# Google ADK — Topos Pipeline Configuration
# Copy this file to .env and fill in your values

# 1. AUTHENTICATION MODE
# ------------------------------------------------------------------------------
# Set to TRUE if using GCP Vertex AI (requires billing enabled)
# Set to FALSE to use AI Studio APIs (uses GOOGLE_API_KEY below)
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Set to TRUE if you have a PAID AI Studio key to bypass free tier rate limits
GOOGLE_GENAI_PAID_API_KEY=FALSE

# Your AI Studio API Key (Leave empty if using Vertex AI)
# Get a free key: https://aistudio.google.com/apikey
# GOOGLE_API_KEY=YOUR_API_KEY_HERE

# ── Model Configuration ──
# Override the default models used by the ADK agents.
# Defaults are optimized for Vertex AI.
# ⚠️ If using AI Studio (Free Tier), use `gemini-2.0-flash-lite`
# for all agents to avoid 429 RESOURCE_EXHAUSTED errors (2 RPM limit on Pro).

# TOPOS_MODEL_ORCHESTRATOR=gemini-2.0-flash
# TOPOS_MODEL_ARCHON=gemini-2.5-pro
# TOPOS_MODEL_ONTOS=gemini-2.5-pro
# TOPOS_MODEL_PRAGMA=gemini-2.5-flash

