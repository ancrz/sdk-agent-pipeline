# =============================================
# AGENT ENGINE — model gateway (HA) + A2A workers
# =============================================
# python3 scripts/bootstrap_env.py   creates .env from this file and generates every empty secret.

COMPOSE_PROJECT_NAME=agent-engine
# With OpenBao (vault-transit-stack): uncomment, and set ENGINE_SECRET_BACKEND=openbao below.
# COMPOSE_FILE=docker-compose.yml:docker-compose.openbao.yml
ENGINE_IMAGE_PREFIX=agent-engine
ENGINE_IMAGE_TAG=latest
ENGINE_CONTAINER_PREFIX=engine
ENGINE_RESTART_POLICY=unless-stopped
ENGINE_LOG_MAX_SIZE=10m
ENGINE_LOG_MAX_FILE=5
ENGINE_TIMEZONE=UTC

# ── Sources of truth (generated) ─────────────────────────────
POSTGRES_DB=engine
POSTGRES_USER=engine
POSTGRES_PASSWORD=
VALKEY_PASSWORD=

# ── Models ───────────────────────────────────────────────────
# Resolution per call: the active preset's profile for the role → its default profile → this .env.
# Presets: offline (deterministic stand-in, no provider) · demo-free · paid · custom · local.
# Switch: docker compose --profile admin run --rm admin preset activate offline
GOOGLE_API_KEY=
ENGINE_DEFAULT_MODEL=gemini-3.5-flash-lite
ENGINE_FALLBACK_MODEL=
# The consuming application's chat/planner: the superior model; the workers stay on small ones.
ENGINE_MODEL_ORCHESTRATOR=
ENGINE_MODEL_DOCUMENTALIST=
ENGINE_MODEL_EXECUTOR=
ENGINE_MODEL_VALIDATOR=
ENGINE_MODEL_AUTHOR=
ENGINE_MODEL_MEDIC=
ENGINE_EMBEDDING_MODEL=gemini-embedding-001
# gemini | deterministic (the first schema run then seeds the offline preset active)
ENGINE_LLM_MODE=gemini
GOOGLE_GENAI_PAID_API_KEY=FALSE

# ── Gateway tokens (generated): the role is derived from the token ──
ENGINE_GATEWAY_TOKEN_ORCHESTRATOR=
ENGINE_GATEWAY_TOKEN_EXECUTOR=
ENGINE_GATEWAY_TOKEN_VALIDATOR=
ENGINE_GATEWAY_TOKEN_DOCUMENTALIST=
ENGINE_GATEWAY_TOKEN_AUTHOR=
ENGINE_GATEWAY_TOKEN_MEDIC=
ENGINE_GATEWAY_TOKEN_EMBEDDINGS=
ENGINE_GATEWAY_ADMIN_TOKEN=

# ── Gateway limits (0 or empty = unlimited) ──────────────────
MODEL_GATEWAY_PORT=8095
MODEL_GATEWAY_WORKERS=1
ENGINE_GATEWAY_MAX_WAIT_S=30
ENGINE_GATEWAY_RPM_FREE=10
ENGINE_GATEWAY_RPM_PAID=0
ENGINE_GATEWAY_RPD_FREE=0
ENGINE_GATEWAY_RPD_PAID=0
ENGINE_GATEWAY_RPM=
ENGINE_GATEWAY_DAILY_TOKENS=

# ── Workers ──
# documentalist needs nothing else. executor, validator, medic and author act through an Ansible
# Controller's MCP front: add them here and set AAP_MCP_URL (an aap-mcp-server in front of the Controller).
ENGINE_AGENT_ROLES=documentalist
WORKER_PORT=8080
AAP_MCP_URL=
KNOWLEDGE_MCP_URL=
ENGINE_KNOWLEDGE_TOKEN=
# Any other MCP server (docs/mcp.md): a JSON list here, or a file in config/mcp/ (mounted at /app/config/mcp)
# e.g. ENGINE_MCP_SERVERS_FILE=/app/config/mcp/servers.example.json  (with the mcp-example profile)
ENGINE_MCP_SERVERS=
ENGINE_MCP_SERVERS_FILE=

# ── Secret store for provider keys ───────────────────────────
# local: Fernet in Postgres with ENGINE_CREDENTIALS_KEY (generated)
# openbao: vault-transit-stack (enable COMPOSE_FILE above; run its scripts/start.sh first)
ENGINE_SECRET_BACKEND=local
ENGINE_CREDENTIALS_KEY=
VAULT_STACK_DIR=../vault-transit-stack
BAO_SECRETS_NETWORK_NAME=bao-secrets-net
ENGINE_BAO_ADDR=https://openbao-secrets:8200
ENGINE_BAO_MOUNTS={"model_provider":"agent-ai"}
HOST_GID=1000

# ── Networks (172.29.0.0/16; consumers join engine-agents-net as external) ──
ENGINE_AGENTS_NETWORK_NAME=engine-agents-net
ENGINE_AGENTS_SUBNET=172.29.43.0/24
ENGINE_DATA_SUBNET=172.29.44.0/24
ENGINE_EGRESS_SUBNET=172.29.40.0/24
ENGINE_LLM_SUBNET=172.29.45.0/24
ENGINE_LLM_PULL_SUBNET=172.29.46.0/24

# ── Resources ────────────────────────────────────────────────
MODEL_GATEWAY_MEM_LIMIT=192m
MODEL_GATEWAY_CPU_LIMIT=1.0
WORKER_AGENTS_MEM_LIMIT=1g
WORKER_AGENTS_CPU_LIMIT=2
POSTGRES_MEM_LIMIT=512m
VALKEY_MEM_LIMIT=192m
